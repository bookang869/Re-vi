# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Required (docker-compose fails fast via ${VAR:?...} if unset) ---

# Shared HMAC/Bearer secret. Must match secrets/revi_webhook_secret (Alertmanager
# reads that file, the Gateway reads this var — same value, two consumers).
# Generate with: openssl rand -hex 32
REVI_WEBHOOK_SECRET=

# GitHub token scoped to repository_dispatch ONLY on REVI_GITHUB_REPO.
# Gateway-only — this token never enters the GitHub Actions runner.
GITHUB_TOKEN_DISPATCH=

# Owner/name of the repo hermes-triage.yml lives in (the scratch repo for now).
REVI_GITHUB_OWNER=
REVI_GITHUB_REPO=

# Tailscale auth key for the tailscale sidecar (Funnel tunnel, PLAN 5.1).
# Settings -> Keys -> Generate auth key in the Tailscale admin console.
# Non-ephemeral, reusable, expires in 90 days by default.
TS_AUTHKEY=

# --- Optional (safe defaults if unset) ---

# PR_REVIEW (default, safer) or AUTONOMOUS. Invalid/unset always falls back to PR_REVIEW.
REVI_MODE=PR_REVIEW

# Local time the digest cron goroutine flushes NATS KV to Slack.
REVI_DIGEST_TIME=08:00

# Slack incoming webhook for the #triage-morning-review digest.
SLACK_DIGEST_WEBHOOK_URL=

# HMAC-signed escalation webhook (PR_READY / APP_BOOT_FAILURE / REGRESSION / EXHAUSTION pages).
REVI_ESCALATION_WEBHOOK_URL=
REVI_ESCALATION_WEBHOOK_SECRET=
